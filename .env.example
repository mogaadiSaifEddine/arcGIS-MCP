# ArcGIS Location Platform / Online API key (scope it to only the services you need:
# portal search, feature services, geocoding, routing).
ARCGIS_API_KEY=

# Optional: ArcGIS Enterprise portal REST URL. Defaults to ArcGIS Online.
# ARCGIS_PORTAL_URL=https://www.arcgis.com/sharing/rest

# Bearer token clients must send to /api/mcp (Authorization: Bearer <token>).
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Max MCP requests per minute per client (in-memory, per instance). Default 60.
# RATE_LIMIT_PER_MINUTE=60
